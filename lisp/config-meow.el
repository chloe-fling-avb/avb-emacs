(defun config-meow-setup ()
  (if workman (config-meow-setup-workman) (config-meow-setup-qwerty))
  (setq meow-keypad-start-keys '((?c . ?c) (?h . ?h) (?x . ?x) (?m . ?m)))
  (unless workman
    (cl-loop for key in winkeys
             for move in '(windmove-left windmove-down windmove-up windmove-right)
             for flag in '("-L" "-D" "-U" "-R")
             do (let ((binding (cons (concat "C-" key) (tmux-nav move flag))))
                  (meow-normal-define-key binding)
                  (meow-motion-define-key binding)))))

;; Special modes (dashboard, eww, dired, magit...) start in MOTION state,
;; where only the keys below plus the mode's own keymap exist. Stand in for
;; evil-collection: down/up everywhere, left/right per mode.
(defun config-meow-motion-keys ()
  (meow-motion-define-key
   (cons (nth 1 winkeys) #'meow-next)
   (cons (nth 2 winkeys) #'meow-prev))
  (let ((left (nth 0 winkeys)) (right (nth 3 winkeys)))
    (cl-flet ((lr (map l r)
                (define-key map (kbd left) l)
                (define-key map (kbd right) r)))
      (lr special-mode-map #'backward-char #'forward-char)
      (with-eval-after-load 'dired
        (lr dired-mode-map #'dired-up-directory #'dired-find-file))
      (with-eval-after-load 'magit
        (lr magit-mode-map #'magit-section-up #'magit-visit-thing))
      (with-eval-after-load 'eww
        (lr eww-mode-map #'eww-back-url #'eww-follow-link))
      (with-eval-after-load 'org-agenda
        (lr org-agenda-mode-map #'backward-char #'org-agenda-switch-to)))))

(defun config-meow-enable ()
  (setq meow-use-cursor-position-hack t)
  (config-meow-setup)
  (config-meow-motion-keys)
  (meow-global-mode 1))

